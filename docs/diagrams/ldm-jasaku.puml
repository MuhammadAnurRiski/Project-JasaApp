@startuml LDM Jasaku
!theme plain
left to right direction
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 14
skinparam EntityFontSize 16
skinparam EntityFontStyle bold
skinparam EntityAttributeFontSize 13
skinparam EntityAttributeFontStyle bold
skinparam ArrowFontSize 13
skinparam ArrowFontStyle bold
skinparam linetype polyline
skinparam nodesep 60
skinparam ranksep 15
skinparam padding 1
skinparam entitymargin 3
skinparam EntityBackgroundColor #FFFFFF
skinparam EntityBorderColor #455A64
skinparam EntityFontColor #212121
skinparam EntityHeaderBackgroundColor #455A64
skinparam EntityAttributeIconSize 0
skinparam packageBorderColor #FFFFFF
skinparam packageBackgroundColor #FFFFFF
skinparam packageFontSize 0
skinparam packageBorderThickness 0

package "Autentikasi" {
  entity "Role" as role {
    * **id** <<PK>>
    --
    **name**
    **description**
  }

  entity "Pengguna" as pengguna {
    * **id** <<PK>>
    --
    **role_id** <<FK>>
    **email**
    **phone**
    **password_hash**
    **google_id**
    **is_phone_verified**
    **is_email_verified**
    **status**
  }

  entity "Profil Pelanggan" as profil_pelanggan {
    * **id** <<PK>>
    --
    **user_id** <<FK>>
    **full_name**
    **nickname**
    **birth_date**
    **gender**
    **address**
    **avatar_url**
  }
}

package "Mitra" {
  entity "Profil Mitra Jasa" as profil_provider {
    * **id** <<PK>>
    --
    **user_id** <<FK>>
    **full_name**
    **nickname**
    **gender**
    **birth_date**
    **phone**
    **address**
    **domicile**
    **province**
    **city**
    **district**
    **village**
    **profile_photo**
    **ktp_photo**
    **selfie_photo**
    **is_verified**
    **verification_status**
    **is_active**
    **onboarding_completed**
    **rating**
    **total_jobs**
    **total_reviews**
  }

  entity "Lokasi Mitra" as lokasi_provider {
    * **id** <<PK>>
    --
    **provider_id** <<FK>>
    **address**
    **location**
  }

  entity "Dokumen Mitra" as dokumen_provider {
    * **id** <<PK>>
    --
    **provider_id** <<FK>>
    **type**
    **file_url**
    **category_id**
    **description**
  }

  entity "Verifikasi Identitas" as verifikasi_identitas {
    * **id** <<PK>>
    --
    **provider_id** <<FK>>
    **nik**
    **ocr_full_name**
    **ocr_birth_date**
    **face_match_score**
    **face_match_status**
    **liveness_status**
  }

  entity "Metode Payout Mitra" as metode_pembayaran {
    * **id** <<PK>>
    --
    **provider_id** <<FK>>
    **type**
    **provider_name**
    **account_number**
    **account_name**
  }

  entity "Jadwal Mitra" as jadwal_provider {
    * **id** <<PK>>
    --
    **provider_id** <<FK>>
    **work_date**
    **is_booked**
    **order_id** <<FK>>
  }
}

package "Katalog" {
  entity "Kategori" as kategori {
    * **id** <<PK>>
    --
    **name**
    **description**
    **icon_url**
  }

  entity "Layanan" as layanan {
    * **id** <<PK>>
    --
    **category_id** <<FK>>
    **name**
    **description**
  }

  entity "Satuan Harga" as satuan_harga {
    * **id** <<PK>>
    --
    **name**
    **unit**
    **description**
  }

  entity "Tipe Kontrak" as tipe_kontrak {
    * **id** <<PK>>
    --
    **name**
    **description**
  }

  entity "Layanan Mitra" as layanan_provider {
    * **id** <<PK>>
    --
    **provider_id**
    **service_id** <<FK>>
    **description**
  }

  entity "Harga Layanan Mitra" as harga_layanan {
    * **id** <<PK>>
    --
    **provider_service_id** <<FK>>
    **pricing_unit_id** <<FK>>
    **contract_type_id** <<FK>>
    **price**
    **price_with_material**
    **plus_material**
    **unit**
  }

  entity "Layanan-Satuan Harga" as layanan_satuan {
    * **id** <<PK>>
    --
    **service_id** <<FK>>
    **pricing_unit_id** <<FK>>
  }

  entity "Layanan-Tipe Kontrak" as layanan_kontrak {
    * **id** <<PK>>
    --
    **service_id** <<FK>>
    **contract_type_id** <<FK>>
  }
}

package "Pesanan" {
  entity "Pesanan" as pesanan {
    * **id** <<PK>>
    --
    **customer_id** <<FK>>
    **provider_id** <<FK>>
    **custom_task_id** <<FK>>
    **task_provider_id** <<FK>>
    **status**
    **total_price**
    **platform_fee**
    **additional_fee**
    **work_date**
    **start_date**
    **end_date**
    **assignment_type**
    **payout_confirmed**
  }

  entity "Item Pesanan" as item_pesanan {
    * **id** <<PK>>
    --
    **order_id** <<FK>>
    **service_id** <<FK>>
    **pricing_unit_id** <<FK>>
    **contract_type_id** <<FK>>
    **quantity**
    **price**
    **subtotal**
    **with_material**
  }

  entity "Lokasi Pesanan" as lokasi_pesanan {
    * **id** <<PK>>
    --
    **order_id** <<FK>>
    **address**
    **location**
  }

  entity "Lampiran Pesanan" as lampiran_pesanan {
    * **id** <<PK>>
    --
    **order_id** <<FK>>
    **file_url**
  }

  entity "Ekstensi Pesanan" as ekstensi_pesanan {
    * **id** <<PK>>
    --
    **order_id** <<FK>>
    **provider_id**
    **customer_id**
    **requested_date**
    **additional_cost**
    **platform_fee_rate**
    **extension_count**
    **status**
    **response_note**
  }

  entity "Pembayaran" as pembayaran {
    * **id** <<PK>>
    --
    **order_id** <<FK>>
    **method**
    **status**
    **amount**
    **payment_proof**
  }
}

package "Tugas Kustom" {
  entity "Tugas Kustom" as tugas_kustom {
    * **id** <<PK>>
    --
    **customer_id** <<FK>>
    **title**
    **description**
    **budget_per_person**
    **required_people**
    **accepted_count**
    **platform_fee_rate**
    **address**
    **location_detail**
    **publish_days**
    **expires_at**
    **payment_status**
    **status**
  }

  entity "Lokasi Tugas" as lokasi_tugas {
    * **id** <<PK>>
    --
    **task_id** <<FK>>
    **label**
    **address**
    **location**
    **stop_order**
  }

  entity "Mitra Tugas" as provider_tugas {
    * **id** <<PK>>
    --
    **task_id** <<FK>>
    **provider_id** <<FK>>
    **status**
    **work_status**
    **payout_confirmed**
  }
}

package "Review & Laporan" {
  entity "Ulasan" as ulasan {
    * **id** <<PK>>
    --
    **order_id** <<FK>>
    **customer_id** <<FK>>
    **provider_id** <<FK>>
    **rating**
    **review**
  }

  entity "Laporan" as laporan {
    * **id** <<PK>>
    --
    **reporter_id** <<FK>>
    **reporter_role**
    **order_id**
    **subject**
    **description**
    **attachments**
    **status**
    **admin_response**
  }
}

package "Data Pendukung" {
  entity "Wilayah" as wilayah {
    * **id** <<PK>>
    --
    **code**
    **name**
    **level**
    **parent_code**
  }

  entity "Rekening Bank" as rekening_bank {
    * **id** <<PK>>
    --
    **provider_name**
    **account_number**
    **account_name**
    **is_active**
  }

  entity "E-Wallet" as ewallet_admin {
    * **id** <<PK>>
    --
    **provider_name**
    **account_number**
    **account_name**
    **is_active**
  }

  entity "QRIS" as qris_admin {
    * **id** <<PK>>
    --
    **provider_name**
    **qris_image_url**
    **is_active**
  }
}

role ||--|{ pengguna : "memiliki"
pengguna ||--|| profil_pelanggan : "memiliki profil"
pengguna ||--|| profil_provider : "memiliki profil"
pengguna ||--|| lokasi_provider : "memiliki lokasi"

profil_provider ||--|{ dokumen_provider : "memiliki dokumen"
profil_provider ||--|| verifikasi_identitas : "memiliki verifikasi"
profil_provider ||--|{ metode_pembayaran : "memiliki payout"
profil_provider ||--|{ jadwal_provider : "memiliki jadwal"

kategori ||--|{ layanan : "memiliki layanan"
layanan ||--|{ layanan_provider : "ditawarkan"
layanan_provider ||--|{ harga_layanan : "memiliki harga"
satuan_harga ||--|{ harga_layanan : "digunakan"
tipe_kontrak ||--o{ harga_layanan : "opsional"
layanan ||--|{ layanan_satuan : "tersedia satuan"
satuan_harga ||--|{ layanan_satuan : "tersedia di"
layanan ||--|{ layanan_kontrak : "tersedia kontrak"
tipe_kontrak ||--|{ layanan_kontrak : "tersedia di"

profil_pelanggan ||--|{ pesanan : "membuat"
profil_provider ||--|{ pesanan : "menerima"
tugas_kustom ||--o{ pesanan : "berasal dari"
provider_tugas ||--o{ pesanan : "berasal dari"
jadwal_provider }o--o{ pesanan : "terkunci jadwal"

pesanan ||--|{ item_pesanan : "memiliki item"
pesanan ||--o{ lokasi_pesanan : "memiliki lokasi"
pesanan ||--o{ lampiran_pesanan : "memiliki lampiran"
pesanan ||--o{ ekstensi_pesanan : "memiliki ekstensi"
pesanan ||--|| pembayaran : "memiliki pembayaran"
layanan ||--|{ item_pesanan : "tercantum dalam"
satuan_harga ||--|{ item_pesanan : "terspesifikasi"
tipe_kontrak ||--o{ item_pesanan : "opsional"

tugas_kustom ||--|{ lokasi_tugas : "memiliki lokasi"
tugas_kustom ||--|{ provider_tugas : "diterima mitra"
profil_provider ||--|{ provider_tugas : "berpartisipasi"

ulasan }o--|| pesanan : "memiliki ulasan"
ulasan }o--|| pengguna : "menulis"
pengguna ||--|{ ulasan : "menerima ulasan"
pengguna ||--|{ laporan : "membuat laporan"

@enduml
